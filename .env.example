# ---- AI provider (OpenAI-compatible chat completions API) ----
# Copy this file to .env.local and replace the placeholder values.
# These are SERVER-ONLY variables. Never prefix them with NEXT_PUBLIC_.

# Secret key from your AI provider's dashboard
AI_API_KEY=your-api-key-here

# Base URL of the provider's OpenAI-compatible API (no trailing /chat/completions)
# Examples: https://api.openai.com/v1 | https://api.groq.com/openai/v1 | https://openrouter.ai/api/v1
AI_BASE_URL=https://api.openai.com/v1

# Model name exactly as listed by your provider
AI_MODEL=your-model-name

# ---- Supabase (not used yet) ----
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
