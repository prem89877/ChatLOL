# ---- AI provider (OpenAI-compatible chat completions API) ----
# Copy this file to .env.local and replace the placeholder values.
# These are SERVER-ONLY variables. Never prefix them with NEXT_PUBLIC_.

# Secret key from your AI provider's dashboard
AI_API_KEY=your-api-key-here

# Base URL of the provider's OpenAI-compatible API (no trailing /chat/completions)
# Examples: https://api.openai.com/v1 | https://api.groq.com/openai/v1 | https://openrouter.ai/api/v1
AI_BASE_URL=https://api.openai.com/v1

# Model name exactly as listed by your provider
AI_MODEL=your-model-name

# ---- Supabase (NOT used yet) ----
# Chat history is stored in the browser (localStorage), so nothing below is needed today.
# Only for the future Supabase history that needs login (see README, "Conversation history").
# Use a NEW Supabase project for chatLOL, never the Blisscco project.
# The anon key is public by design and is safe in the browser only because Row Level Security is on.
# NEVER put the service_role key in any NEXT_PUBLIC_ variable or in browser code.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
