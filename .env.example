# Copy this file to .env.local and replace the placeholder values. Never commit .env.local.
# In Vercel, add the same variables under Project Settings > Environment Variables, then REDEPLOY.

# ---- AI provider (OpenAI-compatible chat completions API) -- unchanged ----
# SERVER-ONLY variables. Never prefix them with NEXT_PUBLIC_.

# Secret key from your AI provider's dashboard
AI_API_KEY=your-api-key-here

# Base URL of the provider's OpenAI-compatible API (no trailing /chat/completions)
# Examples: https://api.openai.com/v1 | https://api.groq.com/openai/v1 | https://openrouter.ai/api/v1
# Gemini (OpenAI-compatible endpoint): https://generativelanguage.googleapis.com/v1beta/openai
AI_BASE_URL=https://api.openai.com/v1

# Model name exactly as listed by your provider
AI_MODEL=your-model-name

# ---- Supabase Auth + conversation history (REQUIRED) ----
# Supabase Dashboard > Project Settings > API.
# Use the project created for chatLOL. Never the Blisscco project.
# Both values are PUBLIC by design (they ship to the browser); data is protected by Row Level Security.
# The anon key may also be the newer "publishable" key (sb_publishable_...).
# NEVER put the service_role / secret key in this app, in any NEXT_PUBLIC_ variable, or in browser code.
# NEXT_PUBLIC_ values are baked in at build time: after changing them on Vercel, redeploy.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
